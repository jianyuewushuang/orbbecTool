# ---- Python 虚拟环境（uv 创建，可用 pyvenv.cfg 重建，勿提交） ----
/bin/
/lib/
/lib64
/pyvenv.cfg
/.lock
/CACHEDIR.TAG

# ---- Python 缓存 ----
__pycache__/
*.py[cod]

# ---- Orbbec SDK 运行日志（OrbbecSDKConfig_v1.0.xml 指定输出到 ./Log） ----
/Log/
*.log

# ---- 录制与解析产物（体积大，不入库） ----
*.bag
*.mp4
/frames/
/thumbs/

# ---- 编译产物（由 orbbec_recorder.cpp 重新编译生成） ----
/orbbec_recorder
*.o

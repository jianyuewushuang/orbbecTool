# ---- Python 虚拟环境（uv 创建，可用 pyvenv.cfg 重建，勿提交） ----
/bin/
/lib/
/lib64
/pyvenv.cfg
/.lock
/CACHEDIR.TAG

# ---- Python 缓存 ----
__pycache__/
*.py[cod]

# ---- Orbbec SDK 运行日志（OrbbecSDKConfig_v1.0.xml 指定输出到 ./Log） ----
/Log/
*.log

# ---- 录制与解析产物（体积大，不入库） ----
*.bag
*.mp4
/frames/
/thumbs/

# ---- 编译中间文件（预编译的 orbbec_recorder 随仓库分发） ----
*.o
